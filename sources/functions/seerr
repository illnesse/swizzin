#!/usr/bin/env bash
# Seerr helper functions for swizzin

# Install or re-install seerr from source (Node.js 22 + pnpm 10 required)
seerr_build() {
    echo_progress_start "Installing/upgrading Node.js 22.x"
    # Always run the NodeSource setup to ensure the 22.x repo is registered,
    # then install/upgrade — this handles the case where an older node is present.
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - >> "$log" 2>&1 || {
        echo_error "Failed to set up NodeSource 22.x repo"
        exit 1
    }
    apt-get install -y nodejs >> "$log" 2>&1 || {
        echo_error "Failed to install Node.js 22.x"
        exit 1
    }
    node_ver="$(node --version | grep -oP '\d+' | head -1)"
    if [[ "$node_ver" -lt 22 ]]; then
        echo_error "Node.js 22.x required but got v${node_ver} after install"
        exit 1
    fi
    echo_progress_done "Node.js $(node --version) ready"

    echo_progress_start "Installing/upgrading pnpm 10.x"
    npm install -g pnpm@10 >> "$log" 2>&1 || {
        echo_error "Failed to install pnpm"
        exit 1
    }
    echo_progress_done "pnpm $(pnpm --version) ready"

    echo_progress_start "Cloning/updating Seerr repository"
    if [[ -d /opt/seerr/.git ]]; then
        git -C /opt/seerr fetch --all >> "$log" 2>&1
        git -C /opt/seerr checkout main >> "$log" 2>&1
        git -C /opt/seerr pull origin main >> "$log" 2>&1 || {
            echo_error "Failed to pull latest Seerr source"
            exit 1
        }
    else
        mkdir -p /opt/seerr
        git clone https://github.com/seerr-team/seerr.git /opt/seerr >> "$log" 2>&1 || {
            echo_error "Failed to clone Seerr repository"
            exit 1
        }
        git -C /opt/seerr checkout main >> "$log" 2>&1
    fi
    echo_progress_done "Repository ready"

    echo_progress_start "Installing Seerr dependencies"
    CYPRESS_INSTALL_BINARY=0 pnpm --dir /opt/seerr install --frozen-lockfile >> "$log" 2>&1 || {
        echo_error "Failed to install Seerr dependencies"
        exit 1
    }
    echo_progress_done "Dependencies installed"

    echo_progress_start "Building Seerr"
    pnpm --dir /opt/seerr build >> "$log" 2>&1 || {
        echo_error "Failed to build Seerr"
        exit 1
    }
    echo_progress_done "Seerr built successfully"

    chown -R seerr:seerr /opt/seerr
}
